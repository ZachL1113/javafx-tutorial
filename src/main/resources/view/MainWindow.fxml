<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.topAnchor="1.0" AnchorPane.bottomAnchor="45.0"
                    AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="8.0" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   prefHeight="40.0" promptText="Type a message..."
                   AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0"
                   AnchorPane.rightAnchor="76.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="40.0" prefWidth="75.0" text="Send"
                AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0" />
    </children>
</AnchorPane>
